rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos de la tienda y catálogo: cualquiera los lee, solo el administrador (usuario autenticado) los escribe.
    match /tienda/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /productos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Pedidos: la tienda los crea sin sesión; solo el administrador los lee, cambia o borra.
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'items', 'total'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 100
                    && request.resource.data.total is number;
      allow read, update, delete: if request.auth != null;
    }
  }
}
