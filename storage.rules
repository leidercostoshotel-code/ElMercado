rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes de producto: cualquiera las ve, solo el administrador las sube (máx. 2 MB, solo imágenes).
    match /productos/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{resto=**} { allow read, write: if false; }
  }
}
